# SynapseOS / SynapseForge — Environment Variables
# Copy to .env and adjust if needed

# ─── Frontend (Vite) ──────────────────────────────────────────
VITE_API_URL=http://localhost:8000

# ─── LLM Provider ─────────────────────────────────────────────
LLM_PROVIDER=mistral         # openai | anthropic | mistral | ollama

# ─── Mistral ──────────────────────────────────────────────────
MISTRAL_API_KEY=XPcaNeegmgEaN93y8haynNoPLKS6bmqk

# ─── Anthropic ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ─── Ollama (local) ───────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ─── Model Selection ──────────────────────────────────────────
ANALYSIS_MODEL=mistral-small-2506   # Model used for deep analysis
FAST_MODEL=mistral-small            # Model used for quick analysis

# ─── Server ───────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=5173
